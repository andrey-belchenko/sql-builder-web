{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Sql.Builder.App/Sql.Builder.App.csproj",
        "/property:GenerateFullPaths=true",
        "/property:BuildInParallel=false",
        "/property:SkipCopyBuildProduct=false",
        "/property:DisableFastUpToDateCheck=false",
        "/property:SkipGetTargetFrameworkProperties=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/SqlBuilder.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/Sql.Builder.App"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-generated",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Antlr.Oracle.Generated/Antlr.Oracle.Generated.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
